{
    "manifest_version": 3,
    "name": "AutoShow for PokerNow",
    "version": "1.0.5",
    "description": "Automatically clicks the 'Show Cards' button whenever it appears.",
    "action": {
      "default_popup": "popup.html"
    },
    "permissions": [
      "storage"
    ],
    "content_scripts": [
      {
        "matches": ["*://*.pokernow.club/*", "*://*.pokernow.com/*"],
        "js": ["content.js"]
      }
    ]
  }